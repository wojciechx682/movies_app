{% extends 'base.html.twig' %}

{% block title %}Filmy | Movie App{% endblock %}

{% block body %}

    {% set titleSearch = app.request.query.get('title', '')|trim %}

    <div class="container mt-3 flex-grow-1 d-flex flex-column">

        {% if titleSearch is not empty %}
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <p class="mb-0">Showing results for <strong>"{{ titleSearch }}"</strong></p>
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_home') }}">Clear search</a>
            </div>
        {% endif %}

        {# {% if app.user %}
            <div class="mb-3">
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
            </div>
        {% endif %} #}

        {# <div class="row g-3 flex-grow-1"> #}
        <div class="row g-3">
            {% for movie in movies %}
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="movie-tile h-100">
                        {% if movie.posterPath %}
                            <a href="{{ path('app_movie_show', { id: movie.id }) }}">
                                <img
                                    class="movie-poster"
                                    src="{{ asset(movie.posterPath) }}"
                                    alt="{{ 'Plakat filmu ' ~ movie.title }}"
                                    loading="lazy"
                                    width="300"
                                    height="450"
                                >
                            </a>
                        {% else %}
                            <a class="movie-poster-link" href="{{ path('app_movie_show', { id: movie.id }) }}">
                                <div class="movie-poster movie-poster--placeholder">
                                    <span>Poster unavailable</span>
                                </div>
                            </a>
                        {% endif %}
                        <div class="movie-tile-content">
                            <div>
                                <a href="{{ path('app_movie_show', { id: movie.id }) }}">{{ movie.title }}</a>
                            </div>

                            {% if movie.originalTitle %}
                                <div>{{ movie.originalTitle }} {{ movie.releaseYear }}</div>

                            {% else %}
                                <div>{{ movie.releaseYear }}</div>
                            {% endif %}


                            {% if movie.genres is not empty %}
                                <div class="d-flex flex-wrap gap-1 my-1">
                                    {% for genre in movie.genres %}
                                        <span class="badge rounded-pill text-bg-secondary">{{ genre.name }}</span>
                                    {% endfor %}
                                </div>
                            {% endif %}

{#                            <div>{{ movie.description }}</div>#}

{#                            <div>{{ movie.runtimeMinutes }}</div>#}
                            <div class="small text-body-secondary">
                                Directed by {{ movie.director }}
                            </div>
                            {#                            <div>{{ movie.createdAt | date('Y-m-d') }}</div>#}
                        </div>
                    </div>
                </div>            
            {% else %}
                {# <div>No movies found</div> #}
                {% if titleSearch is not empty %}
                    <div>No movies found for “{{ titleSearch }}”</div>
                {% else %}
                    <div>No movies found</div>
                {% endif %}
            {% endfor %}
        </div>

        {% if totalPages > 1 %}
            <nav class="mt-auto pt-4" aria-label="Movie pagination">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                        {% if currentPage > 1 %}
                            <a class="page-link" href="{{ path('app_home', queryParameters|merge({page: currentPage - 1})) }}" aria-label="Previous page">
                                Previous
                            </a>
                        {% else %}
                            <span class="page-link">Previous</span>
                        {% endif %}
                    </li>

                    {% for pageNumber in 1..totalPages %}
                        <li class="page-item {% if pageNumber == currentPage %}active{% endif %}">
                            {% if pageNumber == currentPage %}
                                <span class="page-link" aria-current="page">{{ pageNumber }}</span>
                            {% else %}
                                <a class="page-link" href="{{ path('app_home', queryParameters|merge({page: pageNumber})) }}" aria-label="Go to page {{ pageNumber }}">
                                    {{ pageNumber }}
                                </a>
                            {% endif %}
                        </li>
                    {% endfor %}

                    <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                        {% if currentPage < totalPages %}
                            <a class="page-link" href="{{ path('app_home', queryParameters|merge({page: currentPage + 1})) }}" aria-label="Next page">
                                Next
                            </a>
                        {% else %}
                            <span class="page-link">Next</span>
                        {% endif %}
                    </li>
                </ul>
            </nav>
        {% endif %}
    </div>
{% endblock %}
