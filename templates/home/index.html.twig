{% extends 'base.html.twig' %}

{% block title %}Filmy | Movie App{% endblock %}

{% block body %}

    <div class="container mt-3">

        {# {% if app.user %}
            <div class="mb-3">
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
            </div>
        {% endif %} #}

        <div class="row g-3">
            {% for movie in movies %}
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="movie-tile h-100">
                        {% if movie.posterPath %}
                            <a href="{{ path('app_movie_show', { id: movie.id }) }}">
                                <img
                                    class="movie-poster"
                                    src="{{ asset(movie.posterPath) }}"
                                    alt="{{ 'Plakat filmu ' ~ movie.title }}"
                                    loading="lazy"
                                    width="300"
                                    height="450"
                                >
                            </a>
                        {% else %}
                            <div class="movie-poster movie-poster--placeholder">
                                <span>Poster unavailable</span>
                            </div>
                        {% endif %}
                        <div class="movie-tile-content">
                            <div>
                                <a href="{{ path('app_movie_show', { id: movie.id }) }}">{{ movie.title }}</a>
                            </div>

                            {% if movie.originalTitle %}
                                <div>{{ movie.originalTitle }} {{ movie.releaseYear }}</div>

                            {% else %}
                                <div>{{ movie.releaseYear }}</div>
                            {% endif %}


                            {% if movie.genres is not empty %}
                                <div class="d-flex flex-wrap gap-1 my-1">
                                    {% for genre in movie.genres %}
                                        <span class="badge rounded-pill text-bg-secondary">{{ genre.name }}</span>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {#
                            {% set movieRating = movieRatings[movie.id] ?? null %}
                            {% if movieRating is not null and movieRating.count > 0 %}
                                <div class="movie-rating-summary" aria-label="Average rating {{ movieRating.average|number_format(1, ',', ' ') }} from {{ movieRating.count }} ratings">
                                    <i class="bi bi-star-fill movie-rating-summary__star" aria-hidden="true"></i>
                                    <span class="movie-rating-summary__average">{{ movieRating.average|number_format(1, ',', ' ') }}</span>
                                    <span class="movie-rating-summary__count">
                                        <span>{{ movieRating.count|number_format(0, ',', ' ') }}</span>
                                        <span class="movie-rating-summary__count-label">ratings</span>
                                    </span>
                                </div>
                            {% else %}
                                <div class="movie-rating-summary movie-rating-summary--empty">No ratings</div>
                            {% endif %}
                            #}

{#                            <div>{{ movie.description }}</div>#}

{#                            <div>{{ movie.runtimeMinutes }}</div>#}
                            <div class="small text-body-secondary">
                                Directed by {{ movie.director }}
                            </div>

                            {% set movieRating = movieRatings[movie.id] ?? null %}
                            {% if movieRating is not null and movieRating.count > 0 %}
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-star-fill"></i>
                                    <span>{{ movieRating.average|number_format(1, ',', ' ') }}</span>
                                    <span>{{ movieRating.count|number_format(0, ',', ' ') }} ratings</span>
                                </div>
                            {% else %}
                                <div>No ratings</div>
                            {% endif %}

                            {#                            <div>{{ movie.createdAt | date('Y-m-d') }}</div>#}
                        </div>
                    </div>
                </div>            
            {% else %}
                <div>No movies found</div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
