{% extends 'base.html.twig' %}

{% block title %}Review{% endblock %}

{% block body %}
    <div class="container">
        <h1>Review</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Id</th>
                    <td>{{ review.id }}</td>
                </tr>
                <tr>
                    <th>Rating</th>
                    <td>{{ review.rating }}</td>
                </tr>
                <tr>
                    <th>Content</th>
                    <td>{{ review.content }}</td>
                </tr>
                <tr>
                    <th>CreatedAt</th>
                    <td>{{ review.createdAt ? review.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th>UpdatedAt</th>
                    <td>{{ review.updatedAt ? review.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
            </tbody>
        </table>

        <a href="{{ path('app_review_index') }}">back to list</a>

{#        <a href="{{ path('app_review_edit', {'id': review.id}) }}">edit</a>#}

        {% if app.user and review.user is same as(app.user) %}
            <a href="{{ path('app_review_edit', {'id': review.id}) }}">edit</a>
            {{ include('review/_delete_form.html.twig') }}
        {% endif %}

{#        {{ include('review/_delete_form.html.twig') }}#}
    </div>
{% endblock %}
