{% extends 'base.html.twig' %}

{% block title %}Movie{% endblock %}

{% block body %}

    <div class="container">
        
        <div class="row g-3">

            <div class="col-sm-4 col-md-4 col-lg-2">
                <div class="movie-tile h-100">
                    {% if movie.posterPath %}
                        <img
                            class="movie-poster"
                            src="{{ asset(movie.posterPath) }}"
                            alt="{{ 'Plakat filmu ' ~ movie.title }}"
                            loading="lazy"
                            width="300"
                            height="450"
                        >
                    {% else %}
                        <div class="movie-poster movie-poster--placeholder">
                            <span>Plakat niedostępny</span>
                        </div>
                    {% endif %}

                </div>
            </div>

            <div class="col">
                <div class="movie-title">{{ movie.title }}</div>

                {% if movie.originalTitle %}   
                    <div>{{ movie.originalTitle }} {{ movie.releaseYear }}</div>                 
                    <div>
                        {% for genre in movie.genres %}
                            {{ genre.name }}{% if not loop.last %}, {% endif %}
                        {% else %}
                            No assigned genres.
                        {% endfor %}
                    </div>                    
                {% else %} 
                    <div>{{ movie.releaseYear }}</div>                   
                    <div>
                        {% for genre in movie.genres %}
                            {{ genre.name }}{% if not loop.last %}, {% endif %}
                        {% else %}
                            No assigned genres.
                        {% endfor %}
                    </div>                    
                {% endif %}

                <div>{{ movie.runtimeMinutes }}</div>

                <div>Director: {{ movie.director }}</div>

                {# <div>{{ ratingAverage }}</div> #}

                {% if ratingAverage is not null %}
                    {% for i in 1..starDisplay|round(0, 'floor') %}
                        <i class="bi bi-star-fill"></i>
                    {% endfor %}

                    {% if decimalPart >= 0.5 %}
                        <i class="bi bi-star-half"></i>
                    {% endif %}

                    {% if remainingStars > 0 %}
                        {% for i in 1..remainingStars %}
                            <i class="bi bi-star"></i>
                        {% endfor %}
                        
                    {% endif %}

                    ({{ ratingAverage }})

                    <div>

                        {% if count < 2 %}
                            {{ count }} rating, {{ commentsCount }} comment
                        {% else %}
                            {{ count }} ratings, 
                            {% if commentsCount < 2 %}
                                {{ commentsCount }} comment
                            {% else %}
                                {{ commentsCount }} comments
                            {% endif %}
                        {% endif %}
                    </div>
                {% else %}
                    <div>No ratings</div>
                {% endif %}




                {# <div>             
                    {% for i in 1..starDisplay|round(0, 'floor') %}
                        <i class="bi bi-star-fill"></i>
                    {% endfor %}

                    {% if decimalPart >= 0.5 %}
                        <i class="bi bi-star-half"></i>
                    {% endif %}

                    ({{ ratingAverage }})
                </div> #}

                

            </div>

        </div>

        <div class="row g-3 mb-4">
            <div class="col">   
                <h5>Description</h5>             
                {{ movie.description }}
            </div>           
        </div>

        

        {# <table class="table">

            <tbody>
               <tr>
                   <th>Id</th>
                   <td>{{ movie.id }}</td>
               </tr>
                <tr>
                    <th>Title</th>
                    <td>{{ movie.title }}</td>
                </tr>
                <tr>
                    <th>OriginalTitle</th>
                    <td>{{ movie.originalTitle }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ movie.description }}</td>
                </tr>
                <tr>
                    <th>ReleaseYear</th>
                    <td>{{ movie.releaseYear }}</td>
                </tr>
                <tr>
                    <th>RuntimeMinutes</th>
                    <td>{{ movie.runtimeMinutes }}</td>
                </tr>
                <tr>
                    <th>Director</th>
                    <td>{{ movie.director }}</td>
                </tr>
                <tr>
                    <th>PosterPath</th>
                    <td>{% if movie.posterPath %}
                            <img
                                class="movie-poster"
                                src="{{ asset(movie.posterPath) }}"
                                alt="{{ 'Plakat filmu ' ~ movie.title }}"
                                loading="lazy"
                                width="300"
                                height="450"
                            >
                        {% else %}
                            <div class="movie-poster movie-poster--placeholder">
                                <span>Plakat niedostępny</span>
                            </div>
                        {% endif %}</td>
                </tr>
                <tr>
                    <th>CreatedAt</th>
                    <td>{{ movie.createdAt ? movie.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
                <tr>
                    <th>UpdatedAt</th>
                    <td>{{ movie.updatedAt ? movie.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
            </tbody>
        </table> #}

        

        {% if is_granted('ROLE_ADMIN') %}

            <div class="d-flex align-items-center gap-2 mb-4">

                <a href="{{ path('app_movie_edit', {'id': movie.id}) }}">edit</a>

                {{ include('movie/_delete_form.html.twig') }}

            </div>

        {% endif %}
        
        {% for review in reviews %}
            <div class="row g-2 review mb-4 p-2 border rounded">              
                <div>Rating: <span class="bold">{{ review.rating }}/10</span></div>
                <div>{{ review.user.email }} {{ review.createdAt ? review.createdAt|date('d.m.Y H:i:s') : '' }}</div>
                <div>{{ review.content ? review.content : 'Rating without comment' }}</div>             
                {% if app.user and review.user is same as(app.user) %}
                    <div class="d-flex align-items-center gap-2">
                        <a href="{{ path('app_review_edit', {id: review.id}) }}" >
                            edit
                        </a>
                        {{ include('review/_delete_form.html.twig') }}
                    </div>
                {% endif %}         
            </div>
        {% else %}
            <div>No ratings</div>
        {% endfor %}

    </div>

{% endblock %}
